# Copy to .env.local. Never commit it.

# Site
NEXT_PUBLIC_SITE_URL=https://mvc-creations.vercel.app   # change to the custom domain once attached
# NEXT_PUBLIC_FEATURE_SHOP=true                          # leave unset to keep shop/retail hidden

# Database (Turso). For local testing: file:./local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=            # must be on a domain verified in Resend, e.g. Margie <book@yourdomain.com>
RESEND_TO_EMAIL=              # where Margie gets new-booking and alert emails

# Admin
ADMIN_PASSWORD=               # long and unique; changing it signs everyone out
CALENDAR_FEED_TOKEN=          # random string; locks /api/calendar.ics?token=...
CRON_SECRET=                  # random string; Vercel sends it to /api/cron/reminders
