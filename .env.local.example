# Copy this file to .env.local and fill in your values
# Never commit .env.local to Git

# Site URL (used for Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://mvccreations.com

# Shopify Storefront API (add when ready to integrate)
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_token

# Email (Resend or SendGrid for contact forms)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# CONTACT_EMAIL=hello@mvccreations.com
